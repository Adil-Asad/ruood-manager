{
  "name": "@ruood/announcement-manager-android",
  "version": "1.0.0",
  "private": true,
  "description": "The RUOOD Announcement Manager as an Android application. A client of GitHub: it signs in with the device flow and commits announcement content to the announcements repository. It never holds the announcement signing key, which is a secret of the publishing workflow.",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "start:go": "expo start",
    "android": "expo run:android",
    "doctor": "expo-doctor",
    "prebuild": "expo prebuild --platform android --clean",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "jest",
    "bundle": "cd android && gradlew.bat createBundleReleaseJsAndAssets",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@ruood/announcement-authoring": "0.1.0",
    "@ruood/announcement-client": "0.1.0",
    "@ruood/announcement-github": "0.1.0",
    "@ruood/announcement-schema": "0.1.0",
    "expo": "~54.0.35",
    "expo-build-properties": "~1.0.9",
    "expo-clipboard": "~8.0.7",
    "expo-constants": "~18.0.13",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.12",
    "expo-image": "~3.0.11",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.0",
    "babel-jest": "^29.7.0",
    "babel-preset-expo": "~54.0.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "expo-doctor": "^1.13.3",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5"
  }
}
